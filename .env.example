# Copy this file to .env and fill in the values.

# Telegram bot token from @BotFather (get it via /newbot).
# Оставь пустым, если не нужен Telegram-бот — лаунчер (npm run start:all)
# запустит только веб-приложение.
TELEGRAM_BOT_TOKEN=

# SQLite database path (optional; defaults to ./data/habit-tracker.db)
# DATABASE_URL=./data/habit-tracker.db

# Donation link (optional). Shown as a support card in Settings and via /support in the bot.
# Оставьте пустым, если не хотите показывать кнопку донатов
DONATION_URL=

# Public address of the web app (optional). Defaults to http://localhost:3000, which
# Telegram refuses to use as an inline-button url, so the menu shows it as text instead.
# Set a publicly reachable address (e.g. an ngrok/tunnel link) to get a real link button.
# Публичный адрес веб-версии (необязательно)
WEB_APP_URL=
